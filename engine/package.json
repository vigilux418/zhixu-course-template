{
  "name": "zhixu-engine",
  "version": "6.0.2",
  "private": true,
  "license": "MIT",
  "description": "知序课程模板的引擎与维护测试。写课不需要安装任何依赖。",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "node build.js",
    "test": "node --test tests/",
    "test:fast": "node tests/fast.js",
    "e2e": "node tests/e2e/run.js",
    "format": "prettier --config .prettierrc.json --ignore-path .prettierignore --write build.js vendor.js src tests ../template/tools",
    "format:check": "prettier --config .prettierrc.json --ignore-path .prettierignore --check build.js vendor.js src tests ../template/tools"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.60.0",
    "prettier": "3.10.1"
  }
}
